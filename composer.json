{
    "name": "bleeding-deacons/fellowship",
    "description": "Server side of the Link messaging app: OAuth device enrolment, per-device key exchange, and encrypted push delivery to Unity members and committees.",
    "type": "wordpress-plugin",
    "license": "MIT (Modified)",
    "authors": [
        {
            "name": "The Bleeding Deacons"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bleedingdeacons/wp-mocks"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "autoload": {
        "psr-4": {
            "Fellowship\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fellowship\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:coverage": "pest --coverage-html ./tests/coverage",
        "build": "php build.php build:production",
        "build:production": "php build.php build:production",
        "build:dev": "php build.php build:dev",
        "build:clean": "php build.php clean",
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcs:fix": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "require-dev": {
        "bleedingdeacons/wp-mocks": "^3.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "psr/container": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    }
}
